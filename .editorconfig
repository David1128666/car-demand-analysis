root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.scala]
indent_size = 2

[*.{java,xml,yml,yaml}]
indent_size = 2

[*.{js,vue,css,html,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
